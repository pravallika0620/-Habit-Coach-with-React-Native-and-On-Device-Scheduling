# ─── React Native App ─────────────────────────────────────────────────────────

# The base URL of the Hono backend API
# For local development with Docker: http://localhost:3000
# For production: https://your-worker.your-subdomain.workers.dev
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# ─── Hono Backend ────────────────────────────────────────────────────────────

# Port the backend server listens on
PORT=3000

# Node environment (development | production)
NODE_ENV=development

# ─── Cloudflare Workers (for production deployment) ──────────────────────────

# Your Cloudflare account ID (find it in the Cloudflare dashboard)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Cloudflare API token with Workers:Edit permission
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# KV Namespace ID for habit stats storage (create via: wrangler kv:namespace create HABIT_STATS)
CLOUDFLARE_KV_NAMESPACE_ID=your-kv-namespace-id
